    "lg": { "$value": "0 10px 25px rgba(0, 0, 0, 0.1)", "$type": "shadow", "$description": "Strong lift — modals, dialogs" }
  },
  "container": {
    "sm": { "$value": "384px", "$type": "dimension", "$description": "Narrow — auth forms, modals" },
    "md": { "$value": "672px", "$type": "dimension", "$description": "Medium — content pages" },
    "lg": { "$value": "1024px", "$type": "dimension", "$description": "Wide — dashboards" },
    "xl": { "$value": "1200px", "$type": "dimension", "$description": "Max width — site container" }
  },
