      "strong": { "$value": "#c4c4c0", "$type": "color", "$description": "Emphasized borders, active states" },
      "subtle": { "$value": "#f0f0ee", "$type": "color", "$description": "Dividers, separators" }
    },
    "interactive": {
      "focus": { "$value": "#22c55e", "$type": "color", "$description": "Focus ring color" }
    },
    "semantic": {
