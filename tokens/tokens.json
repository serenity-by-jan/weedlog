    "caption": { "$type": "typography", "$description": "Helper text, timestamps, metadata", "$value": { "fontFamily": "'Bricolage Grotesque', sans-serif", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0em" }},
    "overline": { "$type": "typography", "$description": "Section dividers, category labels (uppercase intent)", "$value": { "fontFamily": "'Bricolage Grotesque', sans-serif", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.05em" }},
    "code": { "$type": "typography", "$description": "Inline code, data values, monospace", "$value": { "fontFamily": "'SF Mono', 'Fira Code', 'Fira Mono', monospace", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0em" }}
