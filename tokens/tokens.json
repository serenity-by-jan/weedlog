  },
  "transition": {
    "fast": { "$value": "120ms ease", "$type": "transition", "$description": "Micro-interactions — hover, focus" },
    "normal": { "$value": "200ms ease", "$type": "transition", "$description": "Standard transitions — expand, toggle" },
    "slow": { "$value": "350ms ease", "$type": "transition", "$description": "Layout shifts, page transitions" }
