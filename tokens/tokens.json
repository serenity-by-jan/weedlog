{
  "color": {
    "bg": {
      "primary": { "$value": "#ffffff", "$type": "color", "$description": "Page background" },
      "secondary": { "$value": "#f5f5f3", "$type": "color", "$description": "Subtle background for sections, sidebars" },
      "tertiary": { "$value": "#ebebea", "$type": "color", "$description": "Inset backgrounds, wells" },
      "inverse": { "$value": "#1a1a1a", "$type": "color", "$description": "Dark background for inverted sections" }
    },
    "surface": {
      "primary": { "$value": "#ffffff", "$type": "color", "$description": "Card / panel background" },
      "secondary": { "$value": "#f5f5f3", "$type": "color", "$description": "Nested card or secondary surface" },
      "elevated": { "$value": "#ffffff", "$type": "color", "$description": "Modals, dropdowns, tooltips" }
    },
    "text": {
      "primary": { "$value": "#1a1a1a", "$type": "color", "$description": "Headings, important body text — WCAG AAA on white" },
      "secondary": { "$value": "#525252", "$type": "color", "$description": "Supporting text, descriptions — WCAG AA on white" },
      "muted": { "$value": "#9a9a98", "$type": "color", "$description": "Placeholders, timestamps, disabled labels — decorative only" },
      "inverse": { "$value": "#ffffff", "$type": "color", "$description": "Text on dark/inverse backgrounds" },
      "on-brand": { "$value": "#ffffff", "$type": "color", "$description": "Text on brand-colored backgrounds" }
    },
    "brand": {
      "primary": { "$value": "#16a34a", "$type": "color", "$description": "Main brand green — buttons, links, accents. 4.5:1 on white." },
